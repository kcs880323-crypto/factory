{
  "_comment": "우리집 가계부(Smart Ledger, csjhth.ai.studio) 카드 자동 등록 설정. 사이트의 '변동지출 추가'와 같은 요청을 보낸다. 분류 이름은 사이트의 기본 분류 목록(대분류 → 중분류) 그대로. 규칙은 위에서부터 처음 맞는 것을 쓰고, 그보다 먼저 이 가계부의 지난 3개월 기록(같은 가맹점을 어디에 넣었는지)을 본다.",
  "owners": ["창수", "지현"],
  "add": {
    "method": "POST",
    "path": "/api/monthly-details/add-single",
    "body": {
      "date": "{date}",
      "type": "변동지출",
      "category_large": "{large}",
      "category_medium": "{medium}",
      "details": "{merchant}",
      "amount": "{amount}",
      "earner_name": "{owner}",
      "memo": "{card}"
    }
  },
  "history": {
    "path": "/api/monthly-details?month={month}",
    "fields": {
      "details": "details", "large": "category_large", "medium": "category_medium", "amount": "amount",
      "date": "date", "memo": "memo", "owner": "earner_name", "id": "id", "table": "source_table"
    }
  },
  "delete": {
    "method": "DELETE",
    "path": "/api/monthly-details/delete-single",
    "body": { "id": "{id}", "source_table": "{table}" }
  },
